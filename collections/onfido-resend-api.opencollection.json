{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onfido Resend API",
    "version": "v3.6"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Resend",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Resends webhooks",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.{region}.onfido.com/v3.6/webhooks/resend",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Resends events to all webhooks registered with a matching environment in your account.\n"
        }
      ]
    }
  ],
  "bundled": true
}