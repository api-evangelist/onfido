{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onfido Report API",
    "version": "v3.6"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Report",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Force new report creation (BETA)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.{region}.onfido.com/v3.6/watchlist_monitors/:monitor_id/new_report",
            "params": [
              {
                "name": "monitor_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Triggers a new check with an updated report to be generated by the monitor, as if the monitor had received an update.\n"
        }
      ]
    }
  ],
  "bundled": true
}