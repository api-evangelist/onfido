{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onfido Pick API",
    "version": "v3.6"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pick",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Address Picker",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.{region}.onfido.com/v3.6/addresses/pick",
            "params": [
              {
                "name": "postcode",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search for addresses by postcode\n"
        }
      ]
    }
  ],
  "bundled": true
}