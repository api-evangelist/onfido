{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onfido Video API",
    "version": "v3.6"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Video",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download document video",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.{region}.onfido.com/v3.6/documents/:document_id/video/download",
            "params": [
              {
                "name": "document_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Downloads a document video. If successful, the response will be the binary data representing the video.\n"
        }
      ]
    }
  ],
  "bundled": true
}