{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onfido Frame API",
    "version": "v3.6"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Frame",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download live video frame",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.{region}.onfido.com/v3.6/live_videos/:live_video_id/frame",
            "params": [
              {
                "name": "live_video_id",
                "value": "",
                "type": "path",
                "description": "The live video's unique identifier."
              }
            ]
          },
          "docs": "Returns the binary data representing a single frame from a live video."
        },
        {
          "info": {
            "name": "Download motion capture frame",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.{region}.onfido.com/v3.6/motion_captures/:motion_capture_id/frame",
            "params": [
              {
                "name": "motion_capture_id",
                "value": "",
                "type": "path",
                "description": "The motion capture's unique identifier."
              }
            ]
          },
          "docs": "Instead of the whole capture binary, a single frame can be downloaded using this endpoint. Returns the binary data representing the frame."
        }
      ]
    }
  ],
  "bundled": true
}