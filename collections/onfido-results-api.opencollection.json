{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onfido Results API",
    "version": "v3.6"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Results",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fraud reporting (ALPHA)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.{region}.onfido.com/v3.6/results_feedback",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Feedback on checks and reports\n"
        }
      ]
    }
  ],
  "bundled": true
}