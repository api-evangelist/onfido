{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onfido Pings API",
    "version": "v3.6"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ping",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.{region}.onfido.com/v3.6/ping"
          },
          "docs": "Run a health check on the Onfido API\n"
        }
      ]
    }
  ],
  "bundled": true
}