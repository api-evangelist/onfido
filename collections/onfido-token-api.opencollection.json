{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onfido Token API",
    "version": "v3.6"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate a SDK token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.{region}.onfido.com/v3.6/sdk_token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates an SDK token. Returns a token object containing the SDK token.\n"
        }
      ]
    }
  ],
  "bundled": true
}