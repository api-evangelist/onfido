{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onfido Repeat API",
    "version": "v3.6"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Repeat",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve repeat attempts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.{region}.onfido.com/v3.6/repeat_attempts/:report_id",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns all repeat attempts for a given Document report\n"
        }
      ]
    }
  ],
  "bundled": true
}